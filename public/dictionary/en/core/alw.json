{"always":[{"id":"oewn-always-r","pos":"adverb","pos_tag":"r","pronunciations":[{"text":"ˈɔː(l).weɪz","variety":"GB"},{"text":"ˈɔl.weɪz","variety":"US"}],"senses":[{"definition":"at all times; all the time and on every occasion","examples":["I will always be there to help you","always arrives on time","there is always some pollution in the air","ever hoping to strike it rich","ever busy"],"pos_tag":"r","synonyms":["ever","e'er"],"synset":"oewn-00019801-r"},{"definition":"without variation or change, in every case","examples":["constantly kind and gracious","he always arrives on time"],"pos_tag":"r","synonyms":["constantly","invariably"],"synset":"oewn-00020931-r"},{"definition":"invariably","examples":["the world is constantly changing"],"pos_tag":"r","synonyms":["constantly","forever","perpetually","incessantly"],"synset":"oewn-00020735-r"},{"definition":"at any time or in any event","examples":["you can always resign if you don't like it","you could always take a day off"],"pos_tag":"r","synset":"oewn-00020219-r"},{"definition":"forever; throughout all time","examples":["we will always be friends","I shall treasure it always","I will always love you"],"pos_tag":"r","synset":"oewn-00020071-r"}]}]}