ng polluted","pos_tag":"n","synonyms":["defilement","pollution"],"synset":"oewn-14521988-n"}]}],"befriend":[{"id":"oewn-befriend-v","pos":"verb","pos_tag":"v","pronunciations":[{"text":"bɪˈfɹɛnd","variety":null}],"senses":[{"definition":"become friends with","examples":["John and Eric soon became friends","Have you made friends yet in your new environment?"],"pos_tag":"v","synset":"oewn-02594833-v"}]}],"befuddle":[{"id":"oewn-befuddle-v","pos":"verb","pos_tag":"v","pronunciations":[{"text":"bɪˈfʌdl","variety":"GB"}],"senses":[{"definition":"be confusing or perplexing to; cause to be unable to think clearly","examples":["These questions confuse even the experts","This question completely threw me","This question befuddled even the teacher"],"pos_tag":"v","synonyms":["confuse","throw","fox","fuddle","bedevil","confound","discombobulate"],"synset":"oewn-00623406-v"},{"definition":"make stupid with alcohol","pos_tag":"v","synonyms":["fuddle"],"synset":"oewn-01193274-v"}]}],"befuddled":[{"id":"oewn-befuddled-a","pos":"adjective","pos_tag":"a","senses":[{"definition":"stupefied by alcoholic drink","examples":["the wino's poor befuddled mind","a mind befogged with drink"],"pos_tag":"s","synonyms":["befogged"],"synset":"oewn-00438100-s"},{"definition":"perplexed by many conflicting situations or statements; filled with bewilderment","examples":["obviously bemused by his questions","bewildered and confused","a cloudy and confounded philosopher","just a mixed-up kid","she felt lost on the first day of school"],"pos_tag":"s","synonyms":["baffled","bemused","bewildered","confounded","confused","lost","mazed","mixed-up","at sea"],"synset":"oewn-01770645-s"},{"definition":"confused and vague; used especially of thinking","examples":["muddleheaded ideas","your addled little brain","woolly thinking","woolly-headed ideas"],"pos_tag":"s","synonyms":["addled","muddled","muzzy","woolly","wooly","woolly-headed","wooly-minded"],"synset":"oewn-00437830-s"}]}],"befuddlement":[{"id":"oewn-b