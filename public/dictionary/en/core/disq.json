{"disqualification":[{"id":"oewn-disqualification-n","pos":"noun","pos_tag":"n","pronunciations":[{"text":"dɪsˌkwɒlɪfɪˈkeɪʃən","variety":"GB"},{"text":"dɪsˌkwɑːləfɪˈkeɪʃn","variety":"US"}],"senses":[{"definition":"unfitness that bars you from participation","pos_tag":"n","synset":"oewn-04729850-n"},{"definition":"the act of preventing someone from participating by finding them unqualified","pos_tag":"n","synset":"oewn-01080010-n"}]}],"disqualified":[{"id":"oewn-disqualified-a","pos":"adjective","pos_tag":"a","senses":[{"definition":"disqualified by law or rule or provision","pos_tag":"s","synset":"oewn-00856404-s"},{"definition":"barred from competition for violation of rules","examples":["a disqualified player"],"pos_tag":"s","synset":"oewn-00856503-s"}]}],"disqualify":[{"forms":["disqualified"],"id":"oewn-disqualify-v","pos":"verb","pos_tag":"v","pronunciations":[{"text":"dɪsˈkwɒlɪfaɪ","variety":"GB"}],"senses":[{"definition":"make unfit or unsuitable","examples":["Your income disqualifies you"],"pos_tag":"v","synonyms":["unfit","indispose"],"synset":"oewn-00302119-v"},{"definition":"declare unfit","examples":["She was disqualified for the Olympics because she was a professional athlete"],"pos_tag":"v","synset":"oewn-00974640-v"}]}],"disqualifying":[{"id":"oewn-disqualifying-a","pos":"adjective","pos_tag":"a","senses":[{"definition":"depriving of legal right; rendering legally disqualified","examples":["certain disabling restrictions disqualified him for citizenship"],"pos_tag":"a","synonyms":["disabling"],"synset":"oewn-01198884-a"}]}],"disquiet":[{"id":"oewn-disquiet-n","pos":"noun","pos_tag":"n","pronunciations":[{"text":"dɪsˈkwaɪət","variety":"GB"}],"senses":[{"definition":"a feeling of mild anxiety about possible developments","pos_tag":"n","synonyms":["anxiousness"],"synset":"oewn-07539999-n"},{"definition":"the trait of seeming ill at ease","pos_tag":"n","synonyms":["unease","uneasiness"],"synset":"oewn-04912028-n"}]},{"id":"oewn-disquiet-v","pos":"verb","p