{"piffle":[{"id":"oewn-piffle-n","pos":"noun","pos_tag":"n","pronunciations":[{"text":"ˈpɪf.əl","variety":null}],"senses":[{"definition":"trivial nonsense","pos_tag":"n","synonyms":["balderdash","fiddle-faddle"],"synset":"oewn-06620496-n"}]},{"id":"oewn-piffle-v","pos":"verb","pos_tag":"v","pronunciations":[{"text":"ˈpɪf.əl","variety":null}],"senses":[{"definition":"speak (about unimportant matters) rapidly and incessantly","pos_tag":"v","synonyms":["chatter","palaver","prate","tittle-tattle","twaddle","clack","maunder","prattle","blab","gibber","tattle","blabber","gabble"],"synset":"oewn-01038676-v"},{"definition":"act in a trivial or ineffective way","pos_tag":"v","synset":"oewn-00106597-v"}]}],"piffling":[{"id":"oewn-piffling-a","pos":"adjective","pos_tag":"a","senses":[{"definition":"(informal) small and of little importance","examples":["a fiddling sum of money","a footling gesture","our worries are lilliputian compared with those of countries that are at war","a little (or small) matter","a dispute over niggling details","limited to petty enterprises","piffling efforts","giving a police officer a free meal may be against the law, but it seems to be a picayune infraction"],"pos_tag":"s","synonyms":["fiddling","footling","lilliputian","little","niggling","piddling","petty","picayune","trivial"],"synset":"oewn-01284018-s"}]}]}